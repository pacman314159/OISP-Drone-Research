# Required by Arduino-ESP32 component when using dual 'arduino, espidf' framework
CONFIG_FREERTOS_HZ=1000

# ESP32-S3 8MB Flash & Quad SPI (QIO) Configuration
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHMODE="qio"

# Custom Partition Table Configuration
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Bluetooth & NimBLE Configuration
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y

# SEGGER SystemViewer & Apptrace over JTAG
CONFIG_APPTRACE_DEST_JTAG=y
CONFIG_APPTRACE_ENABLE=y
CONFIG_APPTRACE_SV_ENABLE=y
CONFIG_SYSVIEW_ENABLE=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_APPTRACE_SV_TS_SOURCE_ESP_TIMER=y

# Never stall the CPU when trace buffer full; drop trace packets instead of freezing flight tasks
CONFIG_SYSVIEW_BUF_WAIT_TMO=0
CONFIG_APPTRACE_SV_BUF_WAIT_TMO=0

# Increase trace buffer size to 64 KB (ESP32-S3 has 512 KB SRAM)
CONFIG_APPTRACE_PENDING_DATA_SIZE_MAX=65536

# Reduce JTAG bandwidth saturation: disable high-frequency ISR & Timer spam
CONFIG_APPTRACE_SV_EVT_ISR_ENTER_ENABLE=n
CONFIG_APPTRACE_SV_EVT_ISR_EXIT_ENABLE=n
CONFIG_APPTRACE_SV_EVT_ISR_TO_SCHED_ENABLE=n
CONFIG_APPTRACE_SV_EVT_TIMER_ENTER_ENABLE=n
CONFIG_APPTRACE_SV_EVT_TIMER_EXIT_ENABLE=n

CONFIG_SYSVIEW_EVT_ISR_ENTER_ENABLE=n
CONFIG_SYSVIEW_EVT_ISR_EXIT_ENABLE=n
CONFIG_SYSVIEW_EVT_ISR_TO_SCHEDULER_ENABLE=n
CONFIG_SYSVIEW_EVT_TIMER_ENTER_ENABLE=n
CONFIG_SYSVIEW_EVT_TIMER_EXIT_ENABLE=n
