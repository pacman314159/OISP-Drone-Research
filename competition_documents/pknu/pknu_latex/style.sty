%% =====================================================================
%%  style.sty -- PKNU x HCMUT symposium paper style
%%
%%  Layout layer mapped from the official Word template. The document
%%  file should only carry metadata + text:
%%
%%    \documentclass[10pt,a4paper]{article}
%%    \usepackage{style}
%%    \symposium{...} \title{...} \author{...}
%%    \affiliation{...} \corresponding{...}
%%    \begin{document} \maketitle ... \end{document}
%% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{style}[2026/11/21 PKNU x HCMUT symposium paper style]

% --- Core Packages ---------------------------------------------------
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage[
  a4paper,
  top=1.4cm, bottom=1.4cm,
  left=1.8cm, right=1.8cm,
  headheight=11pt, headsep=0.35cm,
  footskip=0.90cm
]{geometry}
\RequirePackage{newtxtext,newtxmath}  % Times New Roman look-alike
\RequirePackage{textcomp}

% --- Style Packages --------------------------------------------------
\RequirePackage{xcolor}
\RequirePackage{fancyhdr}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{graphicx}
\RequirePackage{caption}
\RequirePackage{titlesec}
\RequirePackage{ragged2e}
\RequirePackage{microtype}
\RequirePackage[hidelinks]{hyperref}

\captionsetup{font=small, labelfont={bf, color=sechead}, textfont=it}

% --- Section Headers ---------------------------------------------------
% Navy template look, plain blocks (no rules), tight spacing.
\titleformat{\section}
  [block]{\normalfont\large\bfseries\color{sechead}}{\thesection}{0.6em}{}
\titleformat{\subsection}
  [block]{\normalfont\normalsize\bfseries\color{sechead}}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}
  [block]{\normalfont\normalsize\itshape\color{sechead}}{\thesubsubsection}{0.6em}{}
\titlespacing*{\section}{0pt}{14pt}{6pt}
\titlespacing*{\subsection}{0pt}{10pt}{4pt}
\titlespacing*{\subsubsection}{0pt}{8pt}{3pt}

% --- Colour Palette (taken from the .docx) ---------------------------
\definecolor{hdrgray}{HTML}{586370}
\definecolor{ftrgray}{HTML}{78818A}
\definecolor{titleink}{HTML}{19222B}
\definecolor{affil}{HTML}{4B555F}
\definecolor{sechead}{HTML}{1B4F72}
\definecolor{kwtext}{HTML}{1F1F1F}

% --- Global Layout ---------------------------------------------------
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}

% --- Header / Footer -------------------------------------------------
% Top-right banner kept from the template; page numbers in the footer
% since a paper runs over several pages.
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[R]{\fontsize{8}{9}\selectfont\bfseries\color{hdrgray}%
  PKNU x HCMUT | JOINT SYMPOSIUM 2027}
\fancyfoot[L]{\fontsize{7.5}{9}\selectfont\color{ftrgray}PKNU-HCMUT}
\fancyfoot[C]{\fontsize{7.5}{9}\selectfont\color{ftrgray}\thepage}
\fancyfoot[R]{\fontsize{7.5}{9}\selectfont\color{ftrgray}JOINT SYMPOSIUM 2027}

% --- Document Metadata ----------------------------------------------
\newcommand{\@symposium}{}
\newcommand{\symposium}[1]{\renewcommand{\@symposium}{#1}}
\newcommand{\@affiliation}{}
\newcommand{\affiliation}[1]{\renewcommand{\@affiliation}{#1}}
\newcommand{\@corresponding}{}
\newcommand{\corresponding}[1]{\renewcommand{\@corresponding}{#1}}

% --- Title Block (\maketitle) ---------------------------------------
% symposium banner -> paper title -> authors -> affiliations -> contact
\renewcommand{\maketitle}{%
  \begin{center}
    {\fontsize{15}{18}\selectfont\bfseries \@symposium\par}
    \vspace{0.55em}
    {\fontsize{14}{17}\selectfont\bfseries\color{titleink} \@title\par}
    \vspace{0.35em}
    {\fontsize{10}{12}\selectfont\bfseries \@author\par}
    \vspace{0.25em}
    {\fontsize{8.5}{10}\selectfont\color{affil} \@affiliation\par}
    \vspace{0.1em}
    {\fontsize{8.5}{10}\selectfont\itshape\color{affil}%
     *Corresponding author: \@corresponding\par}
  \end{center}
  \vspace{0.3em}
}

% --- Lead Section Blocks ---------------------------------------------
% Section heading (11 pt, bold, #1B4F72)
\newcommand{\paperheading}[1]{%
  {\fontsize{11}{13}\selectfont\bfseries\color{sechead}#1\par}%
  \vspace{0.2em}%
}

% Opening paragraph: italic, fully justified, 9.5 pt
\newenvironment{leadblock}{%
  \fontsize{9.5}{12}\selectfont\itshape\justifying
}{%
  \par
}

% Keyword line: bold coloured label + italic dark terms
\newcommand{\keywordline}[1]{%
  \vspace{0.45em}%
  {\fontsize{9}{11}\selectfont
   \textbf{\color{sechead}Keywords:}\hspace{0.35em}%
   {\itshape\color{kwtext}#1}\par}%
  \vspace{0.45em}%
}

% --- Units ------------------------------------------------------------
\newcommand{\us}{\ensuremath{\mu}s}  % microsecond, e.g. 350~\us{}
