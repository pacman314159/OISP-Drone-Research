  "cards": [
    {
      "dot": "cyan",
      "title": "Layering",
      "items": [
        "Includes flow downward only: app → core → middleware → drivers → HAL",
        "FreeRTOS tasks live only in Layer 4 (src/core) and Layer 5 (src/app)",
        "No per-loop heap use: ring buffers are fixed-size statics and log packets are packed structs"
      ]
    },
    {
      "dot": "emerald",
      "title": "Timing budget",
      "items": [
        "IMU DAQ, accel/gyro preprocess and roll/pitch EKF all run at 500 Hz (2 ms period)",
        "Motor 250 Hz · FSM, mag preprocess, yaw/alt EKF, BLE and SD log 100 Hz · RC and power 50 Hz",
        "vTaskDelayUntil with an overrun reset guard; SystemView brackets every task body"
      ]
    },
    {
      "dot": "amber",
      "title": "Shared state",
      "items": [
        "Layer 3 owns every mutex, queue and ring buffer (ipc.h / ipc.cpp)",
        "Producers push samples into ring buffers; consumers snapshot — no shared mutable sample structs",
        "I2C0: MPU6050 + HMC5883L + BMP180 · I2C1: INA226, each guarded by its own bus mutex"
      ]
    },
    {
      "dot": "rose",
      "title": "Where it stops today",
      "items": [
        "No control law is compiled: control_tasks.cpp is a one-line placeholder",
        "Motor task only arms and disarms; INDI output → quad-X mixer is a commented TODO at lines 57–93",
        "LANDING is bypassed — FLIGHT goes straight to POSTFLIGHT on a 3 s button hold"
      ]
    },
    {
      "dot": "violet",
      "title": "How to read it",
      "items": [
        "Arrows show data ownership (who writes or reads a buffer), not direct function calls",
        "Telemetry and blackbox run at priority 1 and never block the 500 Hz sensor path"
      ]
    }
  ]
}
