        <mxCell id="76DSIv0T5LmhMp39YBuT-318" value="PWM Generator" style="rounded=0;whiteSpace=wrap;html=1;arcSize=31;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
